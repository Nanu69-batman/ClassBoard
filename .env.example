# Firebase web app configuration
#
# Copy this file to `.env` and fill in the real values.
#     cp .env.example .env
#
# Where to find them: Firebase console -> your project -> Project settings ->
# "Your apps" -> Web app -> SDK setup and configuration -> "Config".
#
# These six values are PUBLIC BY DESIGN. They ship in every browser bundle.
# Firestore and Storage Security Rules are the real access boundary, not these
# values. It is safe to commit them; it is safe to leave them in .env too.
#
# Only variables prefixed with VITE_ are exposed to the browser. Never prefix a
# secret with VITE_.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
