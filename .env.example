# Copy to .env.local (gitignored). Only the scripts in scripts/ read this file.
#
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key bypasses row-level security. Never commit it, never put
# it in src/, never paste it into a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the URL / anon key committed in src/lib/supabase.ts.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
