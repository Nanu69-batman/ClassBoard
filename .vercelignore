# Files a `vercel` CLI deploy must never upload. (Git-connected deploys only see
# committed files, but the CLI uploads the working folder.)

# Secrets
.env
.env.*
!.env.example
*service-account*.json
*serviceAccount*.json

# Not part of the website: local admin scripts, database migrations, notes
scripts/
supabase/
docs/
project.md

# Build output and dependencies are produced on Vercel
node_modules/
dist/
*.log
