{
  "name": "classboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "seed:dry": "node scripts/seed.mjs --dry-run",
    "invite": "node scripts/invite.mjs",
    "bind:superadmin": "node scripts/bind-superadmin.mjs",
    "db:push": "npx --yes supabase@latest db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
