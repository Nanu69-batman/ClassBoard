{
  "name": "classboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "firebase:login": "npx --yes firebase-tools@latest login",
    "firebase:deploy:rules": "npx --yes firebase-tools@latest deploy --only firestore:rules,storage",
    "firebase:emulators": "npx --yes firebase-tools@latest emulators:start",
    "firebase:emulators:exec": "npx --yes firebase-tools@latest emulators:exec"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
