rules_version = '2';

// Firestore security rules — ClassBoard
//
// STATUS: placeholder. Everything is denied until the data model lands.
//
// This is intentionally deny-all rather than a permissive stand-in. An
// unprotected Firestore project is readable and writable by anyone on the
// internet, so the safe default for a project that is not ready is a closed
// door. M2 replaces the body below with the real matrix:
//
//   student (unauthenticated)  read active classes/subjects/assignments, no writes
//   class CR                   CRUD on their own class only
//   superadmin                 everything
//
// Deploy with:  npm run firebase:deploy:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
